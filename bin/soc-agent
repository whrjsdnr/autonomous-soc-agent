#!/bin/sh
# Project-local entry into the fixed Research MVP worktree. Never invokes sudo.
set -eu
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
entry_path=$(/usr/bin/readlink -f -- "$0")
project_dir=$(CDPATH= cd -- "$(dirname -- "$entry_path")/.." && pwd)
installed="$HOME/.local/share/soc-agent/management/current"
if [ -e "$installed" ] || [ -L "$installed" ]; then
    if [ ! -f "$installed/entry.py" ]; then
        printf '%s\n' 'Installed management release is incomplete; explicit recovery required.' >&2
        exit 2
    fi
    exec /usr/bin/python3 -I -S "$installed/entry.py" "$@"
fi
entry="$project_dir/releases/research-mvp/.venv/bin/soc-agent"
if [ ! -x "$entry" ]; then
    printf '%s\n' 'Research MVP CLI is not installed. See docs/final-report/One_Command_Operation_Guide.md.' >&2
    exit 2
fi
exec "$entry" "$@"
